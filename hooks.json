{
  "loseless-session": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node hooks/loseless-activate.js",
        "timeout": 5
      }
    ]
  },
  "loseless-tracker": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node hooks/loseless-mode-tracker.js",
        "timeout": 5
      }
    ]
  },
  "loseless-gate": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|replace_file_content|write_to_file|apply_diff|insert_content|patch|delete_file|remove_file|create_file|multi_edit|MultiEdit|NotebookEdit|Edit|Write|run_command|bash|Bash|execute_command|run_terminal_cmd",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/loseless-pretool.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
